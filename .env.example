# Application Settings
APP_NAME=HSA Tracker
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-random-string

# Database Configuration
# For PostgreSQL (recommended for production):
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://hsatracker:hsatracker@db:5432/hsatracker

# For SQLite (simple deployments):
# DATABASE_TYPE=sqlite
# DATABASE_URL=sqlite:///./data/hsatracker.db

# AWS S3 Configuration (from Terraform outputs)
AWS_ACCESS_KEY_ID=your-access-key-from-terraform
AWS_SECRET_ACCESS_KEY=your-secret-key-from-terraform
AWS_S3_BUCKET=your-bucket-name-from-terraform
AWS_S3_REGION=us-east-1

# Registration
# Set to true to require an invite token for new account creation.
# Generate tokens with: python backend/scripts/generate_invite.py create --label "for alice"
REQUIRE_INVITE=false

# Authentication Settings
JWT_SECRET_KEY=change-me-in-production-use-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# WebAuthn (Passkey) Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=HSA Tracker
WEBAUTHN_ORIGIN=http://localhost:3000

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/heic,application/pdf

# Web Push / VAPID
# Generate keys once with: cd backend && python scripts/generate_vapid_keys.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_WEBAUTHN_RP_ID=localhost
VITE_VAPID_PUBLIC_KEY=

# PostgreSQL Database Settings (for docker-compose)
POSTGRES_USER=hsatracker
POSTGRES_PASSWORD=hsatracker
POSTGRES_DB=hsatracker
